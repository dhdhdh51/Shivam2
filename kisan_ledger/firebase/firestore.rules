rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin() { return signedIn() && (role() == 'admin' || role() == 'super_admin'); }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /{collection}/{docId} {
      allow read, write: if isAdmin();
    }

    match /fields/{id} { allow read, write: if signedIn() && (resource.data.farmerId == request.auth.uid || request.resource.data.farmerId == request.auth.uid || isAdmin()); }
    match /crops/{id} { allow read, write: if signedIn() && (resource.data.farmerId == request.auth.uid || request.resource.data.farmerId == request.auth.uid || isAdmin()); }
    match /activities/{id} { allow read, write: if signedIn() && (resource.data.farmerId == request.auth.uid || request.resource.data.farmerId == request.auth.uid || isAdmin()); }
    match /expenses/{id} { allow read, write: if signedIn() && (resource.data.farmerId == request.auth.uid || request.resource.data.farmerId == request.auth.uid || isAdmin()); }
    match /irrigation_logs/{id} { allow read, write: if signedIn() && (resource.data.farmerId == request.auth.uid || request.resource.data.farmerId == request.auth.uid || isAdmin()); }
    match /notifications/{id} { allow read: if signedIn() && (resource.data.farmerId == request.auth.uid || isAdmin()); allow write: if isAdmin(); }
    match /support_tickets/{id} { allow read, write: if signedIn() && (resource.data.farmerId == request.auth.uid || request.resource.data.farmerId == request.auth.uid || isAdmin()); }
  }
}
