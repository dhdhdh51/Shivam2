rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /farmer_uploads/{farmerId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == farmerId;
    }
    match /admin_assets/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
